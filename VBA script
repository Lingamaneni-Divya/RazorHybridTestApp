Declare PtrSafe Sub Sleep Lib "kernel32" (ByVal dwMilliseconds As Long) ' Only for 64-bit Excel

Sub UnmergeInChunksWithPause()
    Dim ws As Worksheet
    Dim chunkSize As Long: chunkSize = 10000
    Dim lastRow As Long, startRow As Long, endRow As Long
    Dim cell As Range, area As Range
    Dim val As Variant
    Dim chunkCount As Long: chunkCount = 0

    Set ws = ActiveSheet
    lastRow = ws.UsedRange.Rows(ws.UsedRange.Rows.Count).Row

    Application.ScreenUpdating = False
    Application.Calculation = xlCalculationManual

    For startRow = 1 To lastRow Step chunkSize
        endRow = Application.Min(startRow + chunkSize - 1, lastRow)
        
        For Each cell In ws.Range("A" & startRow & ":Z" & endRow)
            If cell.MergeCells Then
                Set area = cell.MergeArea
                val = area.Cells(1, 1).Value
                area.UnMerge
                area.Value = val
            End If
        Next cell

        chunkCount = chunkCount + 1
        Application.StatusBar = "Processed chunk " & chunkCount & " (" & startRow & " to " & endRow & ")"
        
        ' Pause for 2 seconds
        Sleep 2000 ' milliseconds

        DoEvents ' Keep Excel responsive
    Next startRow

    Application.Calculation = xlCalculationAutomatic
    Application.ScreenUpdating = True
    Application.StatusBar = False

    MsgBox "Done processing all chunks!"
End Sub